
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model etf_infos {
  id                 BigInt               @id @default(autoincrement())
  symbol             String               @unique
  short_name         String?
  long_name          String?
  quote_type         String?
  exchange           String?
  currency           String?
  category           String?
  fund_family        String?
  total_assets       Decimal?             @db.Decimal
  expense_ratio      Decimal?             @db.Decimal
  inception_date     DateTime?            @db.Date
  created            DateTime?            @default(now()) @db.Timestamptz(6)
  updated            DateTime?            @default(now()) @db.Timestamptz(6)
  etf_holdings       etf_holdings[]
  etf_prices         etf_prices[]
  etf_prices_monthly etf_prices_monthly[]
  etf_sector_weights etf_sector_weights[]
  portfolio_assets   portfolio_assets[]

  @@index([symbol], map: "idx_etf_infso_symbol")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model etf_prices {
  id        BigInt    @id @default(autoincrement())
  symbol    String
  date      DateTime  @db.Date
  open      Decimal?  @db.Decimal
  high      Decimal?  @db.Decimal
  low       Decimal?  @db.Decimal
  close     Decimal   @db.Decimal
  adj_close Decimal?  @db.Decimal
  volume    Decimal?  @db.Decimal
  dividend  Decimal?  @default(0) @db.Decimal
  created   DateTime? @default(now()) @db.Timestamptz(6)
  updated   DateTime? @default(now()) @db.Timestamptz(6)
  etf_infos etf_infos @relation(fields: [symbol], references: [symbol], onDelete: Cascade, onUpdate: NoAction, map: "fk_etf_info")

  @@unique([symbol, date])
  @@index([date], map: "idx_etf_prices_date")
  @@index([symbol], map: "idx_etf_prices_symbol")
  @@index([symbol, date], map: "idx_etf_prices_symbol_date")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model etf_prices_monthly {
  id         BigInt    @id @default(autoincrement())
  symbol     String
  date       DateTime  @db.Date
  year_month String
  open       Decimal?  @db.Decimal
  high       Decimal?  @db.Decimal
  low        Decimal?  @db.Decimal
  close      Decimal   @db.Decimal
  adj_close  Decimal?  @db.Decimal
  volume     Decimal?  @db.Decimal
  dividend   Decimal?  @default(0) @db.Decimal
  created    DateTime? @default(now()) @db.Timestamptz(6)
  updated    DateTime? @default(now()) @db.Timestamptz(6)
  etf_infos  etf_infos @relation(fields: [symbol], references: [symbol], onDelete: Cascade, onUpdate: NoAction)

  @@unique([symbol, date])
  @@index([symbol, year_month], map: "idx_etf_prices_monthly_symbol_year_month")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model portfolio_assets {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolio_id String     @db.Uuid
  symbol       String
  weight       Decimal    @db.Decimal(6, 5)
  shares       Decimal?   @default(0) @db.Decimal(15, 6)
  created      DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated      DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  portfolios   portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  etf_infos    etf_infos  @relation(fields: [symbol], references: [symbol], onUpdate: NoAction)

  @@unique([portfolio_id, symbol], map: "portfolio_assets_symbol_unique_check")
  @@index([portfolio_id], map: "idx_portfolio_assets_portfolio_id")
  @@index([symbol], map: "idx_portfolio_assets_symbol")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model portfolio_settings {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolio_id        String              @db.Uuid
  start_date          DateTime            @db.Date
  end_date            DateTime            @db.Date
  rebalance_frequency rebalance_frequency @default(quarterly)
  created             DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated             DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  portfolios          portfolios          @relation(fields: [portfolio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([portfolio_id], map: "idx_portfolio_settings_portfolio_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model portfolios {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created            DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated            DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  name               String
  description        String?
  initial_amount     Decimal              @default(10000) @db.Decimal(15, 2)
  user_id            String?              @db.Uuid
  portfolio_assets   portfolio_assets[]
  portfolio_settings portfolio_settings[]

  @@index([user_id], map: "idx_portfolios_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model etf_holdings {
  id          BigInt    @id @default(autoincrement())
  inserted_at DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at  DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  etf_info_id BigInt
  symbol      String
  name        String    @db.VarChar(255)
  weight      Decimal   @db.Decimal(8, 6)
  etf_infos   etf_infos @relation(fields: [etf_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([etf_info_id, name])
  @@index([etf_info_id], map: "idx_etf_holdings_etf_info_id")
  @@index([etf_info_id, weight(sort: Desc)], map: "idx_etf_holdings_etf_weight")
  @@index([symbol], map: "idx_etf_holdings_symbol")
  @@index([symbol, weight(sort: Desc)], map: "idx_etf_holdings_symbol_weight")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model etf_sector_weights {
  id          BigInt    @id(map: "etf_sector_weight_pkey") @default(autoincrement())
  inserted_at DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at  DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  etf_info_id BigInt
  symbol      String    @db.VarChar(10)
  sector      String    @db.VarChar(50)
  weight      Decimal   @db.Decimal(8, 6)
  etf_infos   etf_infos @relation(fields: [etf_info_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "etf_sector_weight_etf_info_id_fkey")

  @@unique([symbol, sector], map: "etf_sector_weight_symbol_sector_key")
  @@index([symbol], map: "idx_etf_sector_weight_etf_id")
  @@index([symbol, weight(sort: Desc)], map: "idx_etf_sector_weight_etf_weight")
  @@index([sector], map: "idx_etf_sector_weight_sector")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model benchmark_data {
  id               BigInt   @id @default(autoincrement())
  symbol           String
  year_month       String
  monthly_return   Decimal  @db.Decimal
  cumulative_value Decimal  @db.Decimal
  close_price      Decimal? @db.Decimal
  created_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at       DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  @@unique([symbol, year_month], map: "benchmark_data_symbol_year_month_unique")
  @@index([symbol], map: "idx_benchmark_data_monthly_data_symbol")
  @@index([symbol, year_month], map: "idx_benchmark_data_symbol_year_month")
  @@index([symbol, year_month(sort: Desc)], map: "idx_benchmark_data_symbol_year_month_desc")
  @@index([year_month], map: "idx_benchmark_data_year_month")
}

enum rebalance_frequency {
  monthly
  quarterly
  semiannually
  annually
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  isGuest         Boolean   @default(false)
  guestExpiresAt  DateTime?


  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
